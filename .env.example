# ---- Backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used by every key...
LLM_MODEL=gemini/gemini-3.8-flash
# ...or one model per key, aligned with LLM_API_KEYS (optional, overrides LLM_MODEL)
LLM_MODELS=
# SQLite file inside the Docker volume
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure header
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache backend: disk (persists in /data/llm_cache) or local (in-memory)
CACHE_TYPE=disk
CACHE_TTL_SECONDS=86400
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.3
# 0 = no explicit cap
LLM_MAX_TOKENS=0
# How many past messages are sent to the model as context
MAX_HISTORY_MESSAGES=40
# true = offline canned replies (no keys / network needed) for local testing
MOCK_LLM=false

# ---- Frontend (build time) ----
VITE_API_URL=http://localhost:8000
